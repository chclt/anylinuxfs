new file mode 100644
index 0000000..efe2e68
--- /dev/null
+++ b/mtpfs/src/main.cpp
@@ -0,0 +1,298 @@
+#define FUSE_USE_VERSION 29
+#include "catalogue.hpp"
+#include <cmath>
+#include <cstring>
+#include <fcntl.h>
+#include <fuse.h>
+#include <iostream>
+#include <sys/file.h>
+#include <sys/statvfs.h>
+#include <unistd.h>
+
+namespace mtpfs {
+struct Filesystem {
+  Catalogue &catalogue;
+  Transport &transport;
+  uid_t uid;
+  gid_t gid;
+  bool writable;
+};
+Filesystem &fs() {
+  return *static_cast<Filesystem *>(fuse_get_context()->private_data);
+}
+template <class F> int guard(F function) {
+  try {
+    return function();
+  } catch (const std::system_error &e) {
+    if (e.code().value() != ENOENT && e.code().value() != ENODATA)
+      std::fprintf(stderr, "mtpfs: %s\n", e.what());
+    return -e.code().value();
+  } catch (const std::exception &e) {
+    std::fprintf(stderr, "mtpfs: %s\n", e.what());
+    return -EIO;
+  }
+}
+NodeId identify(const char *path, fuse_file_info *file = nullptr) {
+  return file && file->fh ? file->fh : fs().catalogue.lookup(path);
+}
+std::pair<NodeId, std::string> split(const char *path) {
+  std::string value(path);
+  auto slash = value.rfind('/');
+  return {fs().catalogue.lookup(slash == 0 ? "/" : value.substr(0, slash)),
+          value.substr(slash + 1)};
+}
+void attributes(NodeId id, struct stat *st) {
+  auto n = fs().catalogue.node(id);
+  std::memset(st, 0, sizeof(*st));
+  st->st_ino = n.id;
+  st->st_mode = (n.directory ? S_IFDIR : S_IFREG) | n.mode;
+  st->st_uid = fs().uid;
+  st->st_gid = fs().gid;
+  // MTP has no Unix link count; 1 avoids claiming a lazy directory is a leaf.
+  st->st_nlink = n.deleted ? 0 : 1;
+  st->st_size = n.size;
+  auto timestamp = [](double value) {
+    auto seconds = static_cast<time_t>(std::floor(value));
+    return timespec{seconds, static_cast<long>((value - seconds) * 1e9)};
+  };
+  st->st_mtim = timestamp(n.modified);
+  st->st_atim = timestamp(n.accessed);
+  st->st_ctim = timestamp(n.changed);
+  st->st_blksize = cache_block_size;
+  st->st_blocks = (n.size + 511) / 512;
+}
+int getattr(const char *path, struct stat *st) {
+  return guard([&] {
+    attributes(identify(path), st);
+    return 0;
+  });
+}
+int fgetattr(const char *path, struct stat *st, fuse_file_info *fi) {
+  return guard([&] {
+    attributes(identify(path, fi), st);
+    return 0;
+  });
+}
+int readdir(const char *path, void *buf, fuse_fill_dir_t fill, off_t,
+            fuse_file_info *fi) {
+  return guard([&] {
+    auto id = identify(path, fi);
+    fill(buf, ".", nullptr, 0);
+    fill(buf, "..", nullptr, 0);
+    for (auto &n : fs().catalogue.children(id)) {
+      struct stat st{};
+      attributes(n.id, &st);
+      if (fill(buf, n.name.c_str(), &st, 0))
+        break;
+    }
+    return 0;
+  });
+}
+int open(const char *path, fuse_file_info *fi) {
+  return guard([&] {
+    if (!fs().writable && (fi->flags & O_ACCMODE) != O_RDONLY)
+      return -EROFS;
+    fi->fh = identify(path);
+    if (fs().catalogue.node(fi->fh).directory)
+      return -EISDIR;
+    fs().catalogue.open(fi->fh);
+    return 0;
+  });
+}
+int opendir(const char *path, fuse_file_info *fi) {
+  return guard([&] {
+    fi->fh = identify(path);
+    fs().catalogue.load(fi->fh);
+    return 0;
+  });
+}
+int create(const char *path, mode_t, fuse_file_info *fi) {
+  return guard([&] {
+    auto [parent, name] = split(path);
+    fi->fh = fs().catalogue.create(parent, name, false);
+    fs().catalogue.open(fi->fh);
+    return 0;
+  });
+}
+int mkdir(const char *path, mode_t) {
+  return guard([&] {
+    auto [parent, name] = split(path);
+    fs().catalogue.create(parent, name, true);
+    return 0;
+  });
+}
+int mknod(const char *path, mode_t mode, dev_t) {
+  return guard([&] {
+    if (!S_ISREG(mode))
+      return -EOPNOTSUPP;
+    auto [parent, name] = split(path);
+    fs().catalogue.create(parent, name, false);
+    return 0;
+  });
+}
+int unlink(const char *path) {
+  return guard([&] {
+    fs().catalogue.remove(identify(path), false);
+    return 0;
+  });
+}
+int rmdir(const char *path) {
+  return guard([&] {
+    fs().catalogue.remove(identify(path), true);
+    return 0;
+  });
+}
+int rename(const char *from, const char *to) {
+  return guard([&] {
+    auto [parent, name] = split(to);
+    fs().catalogue.rename(identify(from), parent, name);
+    return 0;
+  });
+}
+int read(const char *path, char *buffer, size_t size, off_t offset,
+         fuse_file_info *fi) {
+  return guard([&] {
+    if (offset < 0)
+      return -EINVAL;
+    auto data = fs().catalogue.read(identify(path, fi), offset, size);
+    std::memcpy(buffer, data.data(), data.size());
+    return int(data.size());
+  });
+}
+int write(const char *path, const char *buffer, size_t size, off_t offset,
+          fuse_file_info *fi) {
+  return guard([&] {
+    if (offset < 0)
+      return -EINVAL;
+    fs().catalogue.write(identify(path, fi), offset, buffer, size);
+    return int(size);
+  });
+}
+int truncate(const char *path, off_t size) {
+  return guard([&] {
+    if (size < 0)
+      return -EINVAL;
+    fs().catalogue.truncate(identify(path), size);
+    return 0;
+  });
+}
+int ftruncate(const char *path, off_t size, fuse_file_info *fi) {
+  return guard([&] {
+    if (size < 0)
+      return -EINVAL;
+    fs().catalogue.truncate(identify(path, fi), size);
+    return 0;
+  });
+}
+int fsync(const char *path, int, fuse_file_info *fi) {
+  return guard([&] {
+    fs().catalogue.sync(identify(path, fi));
+    return 0;
+  });
+}
+int flush(const char *path, fuse_file_info *fi) { return fsync(path, 0, fi); }
+int release(const char *path, fuse_file_info *fi) {
+  return guard([&] {
+    fs().catalogue.close(identify(path, fi));
+    return 0;
+  });
+}
+int statfs(const char *, struct statvfs *st) {
+  std::memset(st, 0, sizeof(*st));
+  st->f_bsize = st->f_frsize = 4096;
+  st->f_namemax = 255;
+  for (auto &storage : fs().transport.storages()) {
+    st->f_blocks += storage.capacity / 4096;
+    st->f_bfree += storage.available / 4096;
+  }
+  st->f_bavail = st->f_bfree;
+  st->f_files = st->f_ffree = st->f_favail = 1000000;
+  return 0;
+}
+int utimens(const char *path, const timespec times[2]) {
+  return guard([&] {
+    fs().catalogue.touch(identify(path), times);
+    return 0;
+  });
+}
+int chmod(const char *path, mode_t mode) {
+  return guard([&] {
+    fs().catalogue.chmod(identify(path), mode);
+    return 0;
+  });
+}
+int chown(const char *, uid_t uid, gid_t gid) {
+  return (uid == uid_t(-1) || uid == fs().uid) &&
+                 (gid == gid_t(-1) || gid == fs().gid)
+             ? 0
+             : -EPERM;
+}
+int getxattr(const char *, const char *, char *, size_t) { return -ENODATA; }
+int listxattr(const char *, char *, size_t) { return 0; }
+void *init(fuse_conn_info *) { return fuse_get_context()->private_data; }
+} // namespace mtpfs
+int main(int argc, char **argv) {
+  try {
+    unsigned bus = 0, number = 0;
+    uid_t uid = 0;
+    gid_t gid = 0;
+    bool writable = true;
+    std::vector<char *> arguments{argv[0]};
+    for (int i = 1; i < argc; ++i) {
+      if (std::strncmp(argv[i], "--device=", 9) == 0) {
+        if (std::sscanf(argv[i] + 9, "%u,%u", &bus, &number) != 2)
+          mtpfs::fail(EINVAL, "Invalid MTP device");
+      } else if (std::strncmp(argv[i], "--owner=", 8) == 0) {
+        if (std::sscanf(argv[i] + 8, "%u,%u", &uid, &gid) != 2)
+          mtpfs::fail(EINVAL, "Invalid mount owner");
+      } else if (std::strcmp(argv[i], "--read-only") == 0)
+        writable = false;
+      else
+        arguments.push_back(argv[i]);
+    }
+    const char *cache = std::getenv("ALFS_MTP_CACHE");
+    if (!cache || !bus)
+      mtpfs::fail(EINVAL, "MTP device and ALFS_MTP_CACHE are required");
+    std::filesystem::create_directories(cache);
+    auto lock = mtpfs::open_file(std::filesystem::path(cache) / "owner.lock",
+                                 O_CREAT | O_RDWR);
+    mtpfs::check(flock(lock.get(), LOCK_EX | LOCK_NB) == 0,
+                 "MTP cache is already in use");
+    mtpfs::Transport transport(bus, number, writable);
+    mtpfs::Catalogue catalogue(transport, cache, writable);
+    mtpfs::Filesystem context{catalogue, transport, uid, gid, writable};
+    fuse_operations ops{};
+    ops.init = mtpfs::init;
+    ops.getattr = mtpfs::getattr;
+    ops.fgetattr = mtpfs::fgetattr;
+    ops.readdir = mtpfs::readdir;
+    ops.opendir = mtpfs::opendir;
+    ops.open = mtpfs::open;
+    ops.create = mtpfs::create;
+    ops.mknod = mtpfs::mknod;
+    ops.mkdir = mtpfs::mkdir;
+    ops.unlink = mtpfs::unlink;
+    ops.rmdir = mtpfs::rmdir;
+    ops.rename = mtpfs::rename;
+    ops.read = mtpfs::read;
+    ops.write = mtpfs::write;
+    ops.truncate = mtpfs::truncate;
+    ops.ftruncate = mtpfs::ftruncate;
+    ops.fsync = mtpfs::fsync;
+    ops.flush = mtpfs::flush;
+    ops.release = mtpfs::release;
+    ops.statfs = mtpfs::statfs;
+    ops.utimens = mtpfs::utimens;
+    ops.chmod = mtpfs::chmod;
+    ops.chown = mtpfs::chown;
+    ops.getxattr = mtpfs::getxattr;
+    ops.listxattr = mtpfs::listxattr;
+    ops.flag_nullpath_ok = 1;
+    int result = fuse_main(arguments.size(), arguments.data(), &ops, &context);
+    catalogue.finish();
+    return result;
+  } catch (const std::exception &e) {
+    std::fprintf(stderr, "mtpfs: %s\n", e.what());
+    return 1;
+  }
+}
