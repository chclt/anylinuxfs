new file mode 100644
index 0000000..b6ee66c
--- /dev/null
+++ b/mtpfs/src/catalogue.hpp
@@ -0,0 +1,83 @@
+#pragma once
+#include "transport.hpp"
+#include <map>
+#include <memory>
+#include <set>
+#include <sys/stat.h>
+
+namespace mtpfs {
+struct Node {
+  NodeId id = 0, parent = 0;
+  std::string name;
+  uint32_t storage = 0;
+  bool directory = false, deleted = false, local = false, loaded = false;
+  uint64_t size = 0;
+  double accessed = 0, modified = 0, changed = 0;
+  mode_t mode = 0644;
+};
+
+// Namespace and attributes are session-local. Object IDs never survive a mount.
+// namespace_ serializes name changes; metadata_ protects quick cached lookups
+// and is never held across USB I/O. Each entry's io mutex serializes its data,
+// editing session and open handles. Lock order: namespace_, entry io,
+// metadata_.
+class Catalogue {
+  struct Entry {
+    Node node;
+    std::mutex io;
+    uint32_t object = 0;
+    unsigned handles = 0;
+    bool editing = false;
+    Fd cache;
+    std::set<uint64_t> cached;
+    std::exception_ptr failure;
+  };
+  Transport &transport_;
+  std::filesystem::path root_;
+  bool writable_;
+  std::atomic<bool> failed_{false};
+  std::mutex namespace_, metadata_, status_;
+  NodeId next_ = 1;
+  std::map<NodeId, std::shared_ptr<Entry>> entries_;
+  std::map<std::pair<NodeId, std::string>, NodeId> names_;
+  struct RetainedDirectory {
+    uint32_t object;
+    std::string name;
+  };
+  std::map<uint32_t, RetainedDirectory> retained_;
+  std::shared_ptr<Entry> entry(NodeId);
+  void require_session();
+  void require_write();
+  void load_locked(NodeId);
+  std::string path_locked(NodeId);
+  void begin(Entry &);
+  void end(Entry &);
+  void cache(Entry &);
+  void discard(Entry &);
+  void invalidate(Entry &, uint64_t offset, uint64_t size);
+  void retain(Entry &);
+  void clear_record(const std::filesystem::path &);
+  void status(const std::string &, const std::string &error = {});
+  void namespace_failed(const std::exception &);
+  void data_failed(Entry &);
+
+public:
+  Catalogue(Transport &, std::filesystem::path, bool writable);
+  Node node(NodeId);
+  std::vector<Node> children(NodeId);
+  void load(NodeId);
+  NodeId lookup(const std::string &);
+  NodeId create(NodeId parent, const std::string &, bool directory);
+  void rename(NodeId, NodeId parent, const std::string &);
+  void remove(NodeId, bool directory);
+  void touch(NodeId, const timespec times[2]);
+  void chmod(NodeId, mode_t);
+  void open(NodeId);
+  void close(NodeId);
+  std::vector<char> read(NodeId, uint64_t, size_t);
+  void write(NodeId, uint64_t, const char *, size_t);
+  void truncate(NodeId, uint64_t);
+  void sync(NodeId);
+  void finish();
+};
+} // namespace mtpfs
