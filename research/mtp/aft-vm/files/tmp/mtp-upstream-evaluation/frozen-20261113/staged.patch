index 0000000..e8f8bab
--- /dev/null
+++ b/anylinuxfs/src/mtp_nfs.rs
@@ -0,0 +1,533 @@
+//! Per-mount NFSv3 admission. Namespace consistency remains in the filesystem.
+//! The same loopback listener routes mountd RPCs during mount/unmount. It never
+//! synthesizes replies or reconnects a backend after an uncertain mutation.
+use anyhow::{Context, anyhow, ensure};
+use std::{
+    collections::{BTreeMap, BTreeSet, VecDeque},
+    io::{self, Read, Write},
+    net::{Ipv4Addr, Shutdown, SocketAddr, TcpListener, TcpStream},
+    sync::{
+        Arc, Condvar, Mutex, MutexGuard,
+        atomic::{AtomicBool, Ordering},
+    },
+    thread::{self, JoinHandle},
+    time::Duration,
+};
+
+const WRITE_WINDOW: usize = 4;
+pub(crate) const CLIENT_HOST: &[u8] = b"127.0.0.1";
+const TOTAL_WINDOW: usize = 8;
+const BYTE_LIMIT: usize = 16 * 1024 * 1024;
+const REQUEST_LIMIT: usize = 8192;
+const RECORD_LIMIT: usize = 1024 * 1024;
+const CONNECTION_LIMIT: usize = 8;
+const READ_BURST: usize = 8;
+type Key = (u64, u32);
+
+fn record(stream: &TcpStream) -> anyhow::Result<Option<Vec<u8>>> {
+    let mut stream = stream;
+    let mut body = Vec::new();
+    loop {
+        let mut marker = [0; 4];
+        if stream.read(&mut marker[..1]).context("Read RPC marker")? == 0 {
+            ensure!(body.is_empty(), "Truncated RPC record");
+            return Ok(None);
+        }
+        stream
+            .read_exact(&mut marker[1..])
+            .context("Read RPC marker")?;
+        let marker = u32::from_be_bytes(marker);
+        let count = (marker & 0x7fff_ffff) as usize;
+        ensure!(
+            body.len() + count <= RECORD_LIMIT,
+            "RPC record exceeds limit"
+        );
+        let start = body.len();
+        body.resize(start + count, 0);
+        stream
+            .read_exact(&mut body[start..])
+            .context("Read RPC body")?;
+        if marker & 0x8000_0000 != 0 {
+            return Ok(Some(body));
+        }
+    }
+}
+fn send(stream: &TcpStream, body: &[u8]) -> anyhow::Result<()> {
+    let mut stream = stream;
+    stream
+        .write_all(&(0x8000_0000 | body.len() as u32).to_be_bytes())
+        .context("Write RPC marker")?;
+    stream.write_all(body).context("Write RPC body")
+}
+fn u32_at(body: &[u8], at: usize) -> anyhow::Result<u32> {
+    let b = body.get(at..at + 4).context("Truncated RPC integer")?;
+    Ok(u32::from_be_bytes([b[0], b[1], b[2], b[3]]))
+}
+fn opaque(body: &[u8], at: &mut usize) -> anyhow::Result<Vec<u8>> {
+    let count = u32_at(body, *at)? as usize;
+    *at += 4;
+    let bytes = body
+        .get(*at..*at + count)
+        .context("Truncated RPC opaque")?
+        .to_vec();
+    *at += (count + 3) & !3;
+    ensure!(*at <= body.len(), "Truncated RPC padding");
+    Ok(bytes)
+}
+fn read_only(proc: u32) -> bool {
+    matches!(proc, 0 | 1 | 3 | 4 | 5 | 6 | 16..=20)
+}
+fn handles(body: &[u8], proc: u32) -> anyhow::Result<BTreeSet<Vec<u8>>> {
+    if read_only(proc) {
+        return Ok(BTreeSet::new());
+    }
+    let mut at = 24;
+    for _ in 0..2 {
+        at += 4;
+        opaque(body, &mut at)?;
+    }
+    let mut handles = BTreeSet::from([opaque(body, &mut at)?]);
+    if proc == 14 {
+        opaque(body, &mut at)?;
+        handles.insert(opaque(body, &mut at)?);
+    }
+    if proc == 15 {
+        handles.insert(opaque(body, &mut at)?);
+    }
+    Ok(handles)
+}
+struct Request {
+    key: Key,
+    proc: u32,
+    body: Vec<u8>,
+    handles: BTreeSet<Vec<u8>>,
+    server: Arc<TcpStream>,
+}
+struct Peer {
+    client: Arc<TcpStream>,
+    server: Option<Arc<TcpStream>>,
+    mutated: bool,
+}
+#[derive(Default)]
+struct State {
+    peers: BTreeMap<u64, Peer>,
+    pending: BTreeMap<Key, Arc<Request>>,
+    inflight: BTreeSet<Key>,
+    reads: VecDeque<Key>,
+    mutations: VecDeque<Key>,
+    bytes: usize,
+    read_streak: usize,
+    failure: Option<String>,
+}
+struct Shared {
+    state: Mutex<State>,
+    ready: Condvar,
+    stopped: AtomicBool,
+}
+impl Shared {
+    fn lock(&self) -> anyhow::Result<MutexGuard<'_, State>> {
+        self.state
+            .lock()
+            .map_err(|_| anyhow!("MTP NFS scheduler panicked"))
+    }
+    fn stop(&self, error: Option<String>) {
+        self.stopped.store(true, Ordering::Release);
+        if let Ok(mut state) = self.lock() {
+            if state.failure.is_none() {
+                state.failure = error;
+            }
+            for peer in state.peers.values() {
+                let _ = peer.client.shutdown(Shutdown::Both);
+                if let Some(server) = &peer.server {
+                    let _ = server.shutdown(Shutdown::Both);
+                }
+            }
+        }
+        self.ready.notify_all();
+    }
+    fn close_peer(&self, id: u64, error: Option<String>) -> anyhow::Result<()> {
+        let mut state = self.lock()?;
+        let Some(peer) = state.peers.get(&id) else {
+            return Ok(());
+        };
+        // Even a successfully sent reply might not have reached the client.
+        // Pure mount probes/read-only transports can close normally; after any
+        // dispatched mutation the lifecycle owner must decide whether the volume
+        // was unmounted, rather than silently accepting a new backend session.
+        if peer.mutated && !self.stopped.load(Ordering::Acquire) {
+            drop(state);
+            self.stop(Some(error.unwrap_or_else(|| {
+                "MTP NFS connection closed after a mutation".into()
+            })));
+            return Ok(());
+        }
+        if let Some(peer) = state.peers.remove(&id) {
+            let _ = peer.client.shutdown(Shutdown::Both);
+            if let Some(server) = peer.server {
+                let _ = server.shutdown(Shutdown::Both);
+            }
+        }
+        state.pending.retain(|key, _| key.0 != id);
+        state.bytes = state
+            .pending
+            .values()
+            .map(|request| request.body.len())
+            .sum();
+        state.inflight.retain(|key| key.0 != id);
+        state.reads.retain(|key| key.0 != id);
+        state.mutations.retain(|key| key.0 != id);
+        self.ready.notify_all();
+        Ok(())
+    }
+    fn admit(&self, request: Request) -> anyhow::Result<()> {
+        let mut state = self.lock()?;
+        if let Some(old) = state.pending.get(&request.key) {
+            ensure!(
+                old.body == request.body,
+                "Pending RPC XID reused with different contents"
+            );
+            return Ok(());
+        }
+        while !self.stopped.load(Ordering::Acquire)
+            && (state.bytes + request.body.len() > BYTE_LIMIT
+                || state.pending.len() >= REQUEST_LIMIT)
+        {
+            state = self
+                .ready
+                .wait(state)
+                .map_err(|_| anyhow!("MTP NFS scheduler panicked"))?;
+        }
+        if self.stopped.load(Ordering::Acquire) || !state.peers.contains_key(&request.key.0) {
+            return Ok(());
+        }
+        if read_only(request.proc) {
+            state.reads.push_back(request.key);
+        } else {
+            state.mutations.push_back(request.key);
+        }
+        state.bytes += request.body.len();
+        state.pending.insert(request.key, Arc::new(request));
+        self.ready.notify_all();
+        Ok(())
+    }
+    fn next_mutation(state: &State) -> Option<usize> {
+        let (mut busy_write, mut busy_other) = (BTreeSet::new(), BTreeSet::new());
+        let mut writes = 0;
+        for key in &state.inflight {
+            let request = &state.pending[key];
+            if request.proc == 7 {
+                writes += 1;
+                busy_write.extend(request.handles.iter().cloned());
+            } else {
+                busy_other.extend(request.handles.iter().cloned());
+            }
+        }
+        for (index, key) in state.mutations.iter().enumerate() {
+            let request = &state.pending[key];
+            let blocked = !request.handles.is_disjoint(&busy_other)
+                || (request.proc != 7 && !request.handles.is_disjoint(&busy_write));
+            if !blocked && (request.proc != 7 || writes < WRITE_WINDOW) {
+                return Some(index);
+            }
+            // Preserve explicit same-handle barriers across queued mutations.
+            // This is not an alias map for rename/replacement targets.
+            if request.proc == 7 {
+                busy_write.extend(request.handles.iter().cloned());
+            } else {
+                busy_other.extend(request.handles.iter().cloned());
+            }
+        }
+        None
+    }
+    fn dispatch(&self) -> anyhow::Result<()> {
+        loop {
+            let mut state = self.lock()?;
+            let key = loop {
+                if self.stopped.load(Ordering::Acquire) {
+                    return Ok(());
+                }
+                if state.inflight.len() < TOTAL_WINDOW {
+                    let mutation = Self::next_mutation(&state);
+                    if !state.reads.is_empty()
+                        && (mutation.is_none() || state.read_streak < READ_BURST)
+                    {
+                        state.read_streak = (state.read_streak + 1).min(READ_BURST);
+                        if let Some(key) = state.reads.pop_front() {
+                            break key;
+                        }
+                    } else if let Some(index) = mutation {
+                        state.read_streak = 0;
+                        if let Some(key) = state.mutations.remove(index) {
+                            break key;
+                        }
+                    }
+                }
+                state = self
+                    .ready
+                    .wait(state)
+                    .map_err(|_| anyhow!("MTP NFS scheduler panicked"))?;
+            };
+            let request = Arc::clone(&state.pending[&key]);
+            state.inflight.insert(key);
+            if !read_only(request.proc) {
+                state
+                    .peers
+                    .get_mut(&key.0)
+                    .context("Missing RPC peer")?
+                    .mutated = true;
+            }
+            drop(state);
+            if let Err(error) = send(&request.server, &request.body) {
+                self.close_peer(key.0, Some(format!("{error:#}")))?;
+            }
+        }
+    }
+}
+
+pub(crate) struct Relay {
+    pub port: u16,
+    shared: Arc<Shared>,
+    owner: Mutex<Option<JoinHandle<()>>>,
+}
+impl Relay {
+    pub fn start(upstream: SocketAddr) -> anyhow::Result<Self> {
+        let listener =
+            TcpListener::bind((Ipv4Addr::LOCALHOST, 0)).context("Bind MTP NFS scheduler")?;
+        let port = listener
+            .local_addr()
+            .context("Read MTP NFS scheduler port")?
+            .port();
+        listener
+            .set_nonblocking(true)
+            .context("Configure MTP NFS listener")?;
+        let shared = Arc::new(Shared {
+            state: Mutex::new(State::default()),
+            ready: Condvar::new(),
+            stopped: AtomicBool::new(false),
+        });
+        let worker = Arc::clone(&shared);
+        let owner = thread::spawn(move || {
+            let sender = Arc::clone(&worker);
+            let dispatcher = thread::spawn(move || {
+                if let Err(e) = sender.dispatch() {
+                    sender.stop(Some(format!("{e:#}")));
+                }
+            });
+            if let Err(e) = listen(listener, upstream, &worker) {
+                worker.stop(Some(format!("{e:#}")));
+            }
+            worker.stop(None);
+            if dispatcher.join().is_err() {
+                worker.stop(Some("MTP NFS dispatcher panicked".into()));
+            }
+            if let Ok(mut state) = worker.lock() {
+                state.peers.clear();
+                state.pending.clear();
+                state.inflight.clear();
+                state.reads.clear();
+                state.mutations.clear();
+                state.bytes = 0;
+            }
+        });
+        Ok(Self {
+            port,
+            shared,
+            owner: Mutex::new(Some(owner)),
+        })
+    }
+    pub fn failure(&self) -> anyhow::Result<Option<String>> {
+        Ok(self.shared.lock()?.failure.clone())
+    }
+    pub fn stop(&self) {
+        self.shared.stop(None);
+        if let Ok(mut owner) = self.owner.lock() {
+            if let Some(thread) = owner.take() {
+                let _ = thread.join();
+            }
+        }
+    }
+}
+fn listen(listener: TcpListener, upstream: SocketAddr, shared: &Arc<Shared>) -> anyhow::Result<()> {
+    let mut workers: Vec<JoinHandle<()>> = Vec::new();
+    let mut cleanup = common_utils::Deferred::new();
+    // Join is below the listener loop so all socket shutdowns precede it.
+    cleanup.add(|| shared.stop(None));
+    let mut next_id = 0;
+    let result = (|| -> anyhow::Result<()> {
+        while !shared.stopped.load(Ordering::Acquire) {
+            let mut index = 0;
+            while index < workers.len() {
+                if workers[index].is_finished() {
+                    workers
+                        .swap_remove(index)
+                        .join()
+                        .map_err(|_| anyhow!("MTP NFS peer panicked"))?;
+                } else {
+                    index += 1;
+                }
+            }
+            match listener.accept() {
+                Ok((stream, _)) => {
+                    if workers.len() >= CONNECTION_LIMIT {
+                        continue;
+                    }
+                    // BSD accept inherits the listener's nonblocking flag.
+                    // Framing workers use blocking reads, woken by shutdown.
+                    stream
+                        .set_nonblocking(false)
+                        .context("Configure MTP RPC stream")?;
+                    let client = Arc::new(stream);
+                    let id = next_id;
+                    next_id += 1;
+                    shared.lock()?.peers.insert(
+                        id,
+                        Peer {
+                            client: Arc::clone(&client),
+                            server: None,
+                            mutated: false,
+                        },
+                    );
+                    let state = Arc::clone(shared);
+                    workers.push(thread::spawn(move || {
+                        let result = connection(id, &client, upstream, &state);
+                        if let Err(e) = state.close_peer(id, result.err().map(|e| format!("{e:#}")))
+                        {
+                            state.stop(Some(format!("{e:#}")));
+                        }
+                    }));
+                }
+                Err(e) if e.kind() == io::ErrorKind::WouldBlock => {
+                    thread::sleep(Duration::from_millis(20))
+                }
+                Err(e) => return Err(e).context("Accept MTP NFS connection"),
+            }
+        }
+        Ok(())
+    })();
+    drop(cleanup);
+    for thread in workers {
+        if thread.join().is_err() {
+            shared.stop(Some("MTP NFS peer panicked".into()));
+        }
+    }
+    result
+}
+fn connection(
+    id: u64,
+    client: &Arc<TcpStream>,
+    upstream: SocketAddr,
+    shared: &Arc<Shared>,
+) -> anyhow::Result<()> {
+    let Some(first) = record(client)? else {
+        return Ok(());
+    };
+    let program = u32_at(&first, 12)?;
+    ensure!(
+        matches!(program, 100003 | 100005),
+        "Expected NFS or mountd RPC"
+    );
+    let port = if program == 100003 { 2049 } else { 32767 };
+    let mut backend = upstream;
+    backend.set_port(port);
+    let server = Arc::new(
+        TcpStream::connect_timeout(&backend, Duration::from_secs(5))
+            .context("Connect MTP RPC backend")?,
+    );
+    server
+        .set_nodelay(true)
+        .context("Configure MTP RPC backend")?;
+    client
+        .set_nodelay(true)
+        .context("Configure MTP RPC client")?;
+    {
+        let mut state = shared.lock()?;
+        if shared.stopped.load(Ordering::Acquire) {
+            return Ok(());
+        }
+        state.peers.get_mut(&id).context("Missing RPC peer")?.server = Some(Arc::clone(&server));
+    }
+    if program == 100005 {
+        let mut body = first;
+        loop {
+            ensure!(
+                u32_at(&body, 12)? == 100005,
+                "RPC program changed on mountd connection"
+            );
+            send(&server, &body)?;
+            let reply = record(&server)?.context("Mountd disconnected before reply")?;
+            send(client, &reply)?;
+            match record(client)? {
+                Some(next) => body = next,
+                None => return Ok(()),
+            }
+        }
+    }
+    let receiver = Arc::clone(shared);
+    let reply_client = Arc::clone(client);
+    let reply_server = Arc::clone(&server);
+    let replies = thread::spawn(move || {
+        let result = forward_replies(id, &reply_client, &reply_server, &receiver);
+        if let Err(e) = receiver.close_peer(id, result.err().map(|e| format!("{e:#}"))) {
+            receiver.stop(Some(format!("{e:#}")));
+        }
+    });
+    let result = (|| -> anyhow::Result<()> {
+        let mut body = first;
+        loop {
+            ensure!(
+                (
+                    u32_at(&body, 4)?,
+                    u32_at(&body, 8)?,
+                    u32_at(&body, 12)?,
+                    u32_at(&body, 16)?
+                ) == (0, 2, 100003, 3),
+                "Expected NFSv3 RPC"
+            );
+            let proc = u32_at(&body, 20)?;
+            ensure!(proc <= 21, "Unknown NFSv3 procedure");
+            shared.admit(Request {
+                key: (id, u32_at(&body, 0)?),
+                proc,
+                handles: handles(&body, proc)?,
+                body,
+                server: Arc::clone(&server),
+            })?;
+            match record(client)? {
+                Some(next) => body = next,
+                None => return Ok(()),
+            }
+        }
+    })();
+    let close = shared.close_peer(id, result.as_ref().err().map(|e| format!("{e:#}")));
+    replies
+        .join()
+        .map_err(|_| anyhow!("MTP NFS reply worker panicked"))?;
+    close?;
+    result
+}
+fn forward_replies(
+    id: u64,
+    client: &TcpStream,
+    server: &TcpStream,
+    shared: &Shared,
+) -> anyhow::Result<()> {
+    while let Some(body) = record(server)? {
+        ensure!(u32_at(&body, 4)? == 1, "Expected RPC reply");
+        let key = (id, u32_at(&body, 0)?);
+        {
+            let state = shared.lock()?;
+            if shared.stopped.load(Ordering::Acquire) {
+                return Ok(());
+            }
+            ensure!(state.inflight.contains(&key), "Unexpected NFS reply XID");
+        }
+        send(client, &body)?;
+        let mut state = shared.lock()?;
+        if let Some(request) = state.pending.remove(&key) {
+            state.bytes -= request.body.len();
+        }
+        state.inflight.remove(&key);
+        shared.ready.notify_all();
+    }
+    Ok(())
+}
