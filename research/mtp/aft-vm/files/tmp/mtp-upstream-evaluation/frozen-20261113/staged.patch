new file mode 100644
index 0000000..f0c8428
--- /dev/null
+++ b/mtpfs/src/support.cpp
@@ -0,0 +1,127 @@
+#include "support.hpp"
+#include <chrono>
+#include <fcntl.h>
+#include <fstream>
+#include <iomanip>
+#include <memory>
+#include <openssl/evp.h>
+#include <sstream>
+#include <unistd.h>
+#include <utility>
+
+namespace mtpfs {
+Fd::~Fd() {
+  if (value_ >= 0)
+    ::close(value_);
+}
+Fd::Fd(Fd &&other) noexcept : value_(std::exchange(other.value_, -1)) {}
+Fd &Fd::operator=(Fd &&other) noexcept {
+  if (this != &other) {
+    if (value_ >= 0)
+      ::close(value_);
+    value_ = std::exchange(other.value_, -1);
+  }
+  return *this;
+}
+Fd open_file(const std::filesystem::path &path, int flags, unsigned mode) {
+  int fd = ::open(path.c_str(), flags | O_CLOEXEC, mode);
+  check(fd >= 0, "Open " + path.string());
+  return Fd(fd);
+}
+void sync_file(int fd) { check(::fsync(fd) == 0, "Persist MTP cache data"); }
+void sync_directory(const std::filesystem::path &path) {
+  auto fd = open_file(path, O_RDONLY | O_DIRECTORY);
+  sync_file(fd.get());
+}
+void write_all(int fd, const void *data, size_t size, uint64_t offset) {
+  auto bytes = static_cast<const char *>(data);
+  while (size) {
+    auto written = ::pwrite(fd, bytes, size, offset);
+    if (written < 0 && errno == EINTR)
+      continue;
+    if (written <= 0)
+      fail(written < 0 ? errno : EIO, "Write MTP cache data");
+    bytes += written;
+    offset += written;
+    size -= written;
+  }
+}
+std::vector<char> read_at(int fd, size_t size, uint64_t offset) {
+  std::vector<char> bytes(size);
+  size_t done = 0;
+  while (done < size) {
+    auto count = ::pread(fd, bytes.data() + done, size - done, offset + done);
+    if (count < 0 && errno == EINTR)
+      continue;
+    if (count < 0)
+      fail(errno, "Read MTP cache data");
+    if (!count)
+      break;
+    done += count;
+  }
+  bytes.resize(done);
+  return bytes;
+}
+void atomic_file(const std::filesystem::path &path,
+                 const std::string &content) {
+  auto next = path;
+  next += ".next";
+  auto fd = open_file(next, O_WRONLY | O_CREAT | O_TRUNC);
+  write_all(fd.get(), content.data(), content.size(), 0);
+  sync_file(fd.get());
+  check(::rename(next.c_str(), path.c_str()) == 0, "Publish " + path.string());
+  sync_directory(path.parent_path());
+}
+std::string unique_id() {
+  std::ifstream file("/proc/sys/kernel/random/uuid");
+  std::string id;
+  if (!(file >> id))
+    fail(EIO, "Generate MTP transaction identity");
+  return id;
+}
+namespace {
+using Digest = std::unique_ptr<EVP_MD_CTX, decltype(&EVP_MD_CTX_free)>;
+Digest digest() {
+  Digest ctx(EVP_MD_CTX_new(), EVP_MD_CTX_free);
+  if (!ctx || EVP_DigestInit_ex(ctx.get(), EVP_sha256(), nullptr) != 1)
+    fail(EIO, "Initialize SHA-256");
+  return ctx;
+}
+std::string finish(Digest &ctx) {
+  unsigned char bytes[EVP_MAX_MD_SIZE];
+  unsigned size = 0;
+  if (EVP_DigestFinal_ex(ctx.get(), bytes, &size) != 1)
+    fail(EIO, "Finish SHA-256");
+  std::ostringstream hex;
+  for (unsigned i = 0; i < size; ++i)
+    hex << std::hex << std::setfill('0') << std::setw(2) << unsigned(bytes[i]);
+  return hex.str();
+}
+} // namespace
+std::string hash_text(const std::string &text) {
+  auto ctx = digest();
+  if (EVP_DigestUpdate(ctx.get(), text.data(), text.size()) != 1)
+    fail(EIO, "Hash device identity");
+  return finish(ctx);
+}
+std::string json_quote(const std::string &value) {
+  std::ostringstream out;
+  out << '"';
+  for (unsigned char c : value) {
+    if (c == '"' || c == '\\')
+      out << '\\' << char(c);
+    else if (c < 32)
+      out << "\\u" << std::hex << std::setw(4) << std::setfill('0')
+          << unsigned(c);
+    else
+      out << char(c);
+  }
+  out << '"';
+  return out.str();
+}
+double now() {
+  return std::chrono::duration<double>(
+             std::chrono::system_clock::now().time_since_epoch())
+      .count();
+}
+} // namespace mtpfs
diff --git a/mtpfs/src/support.hpp b/mtpfs/src/support.hpp
new file mode 100644
index 0000000..fad6e77
--- /dev/null
+++ b/mtpfs/src/support.hpp
@@ -0,0 +1,46 @@
+#pragma once
+#include <cerrno>
+#include <cstdint>
+#include <filesystem>
+#include <stdexcept>
+#include <string>
+#include <system_error>
+#include <vector>
+
+namespace mtpfs {
+// Cache only complete read pages. MTP commands remain bounded to allow reads
+// and metadata requests between chunks of a large upload.
+constexpr uint64_t cache_block_size = 64 * 1024;
+constexpr uint64_t transfer_block_size = 1024 * 1024;
+using NodeId = int64_t;
+
+[[noreturn]] inline void fail(int code, const std::string &message) {
+  throw std::system_error(code, std::generic_category(), message);
+}
+inline void check(bool ok, const std::string &message) {
+  if (!ok)
+    fail(errno, message);
+}
+class Fd {
+  int value_ = -1;
+
+public:
+  explicit Fd(int value = -1) : value_(value) {}
+  ~Fd();
+  Fd(const Fd &) = delete;
+  Fd &operator=(const Fd &) = delete;
+  Fd(Fd &&other) noexcept;
+  Fd &operator=(Fd &&other) noexcept;
+  int get() const { return value_; }
+};
+Fd open_file(const std::filesystem::path &, int flags, unsigned mode = 0600);
+void sync_file(int fd);
+void sync_directory(const std::filesystem::path &);
+void write_all(int fd, const void *, size_t, uint64_t offset);
+std::vector<char> read_at(int fd, size_t, uint64_t offset);
+void atomic_file(const std::filesystem::path &, const std::string &);
+std::string unique_id();
+std::string hash_text(const std::string &);
+std::string json_quote(const std::string &);
+double now();
+} // namespace mtpfs
diff --git a/mtpfs/src/transport.cpp b/mtpfs/src/transport.cpp
new file mode 100644
index 0000000..a05df58
--- /dev/null
+++ b/mtpfs/src/transport.cpp
@@ -0,0 +1,278 @@
+#include "transport.hpp"
+#include <cstdlib>
+#include <cstring>
+#include <fcntl.h>
+#include <memory>
+#include <unordered_set>
+
+namespace mtpfs {
+void Transport::checked(int result, const char *operation) {
+  if (!result)
+    return;
+  std::string message(operation);
+  uint16_t response = 0;
+  for (auto error = LIBMTP_Get_Errorstack(device_); error;
+       error = error->next) {
+    if (error->error_text)
+      message += ": " + std::string(error->error_text);
+    if (error->ptp_code)
+      response = error->ptp_code;
+  }
+  LIBMTP_Clear_Errorstack(device_);
+  // A completed rejection of one directory/read is not a dead session. In
+  // particular Android can invalidate a media handle during background scans.
+  if ((response >= 0x2000 && response < 0x3000) ||
+      (response >= 0xa000 && response < 0xb000)) {
+    int code = response == 0x2009 || response == 0x201a ? ENOENT
+               : response == 0x200f                     ? EACCES
+               : response == 0x2005 || response == 0x200a ||
+                       response == 0xa801 || response == 0xa80a
+                   ? EOPNOTSUPP
+                   : EIO;
+    fail(code, message);
+  }
+  // A failed transaction may leave the wire protocol mid-command. Never issue
+  // another operation on that session or retry a possibly completed mutation.
+  failed_ = true;
+  failure_ = std::make_exception_ptr(
+      std::system_error(EIO, std::generic_category(), message));
+  std::rethrow_exception(failure_);
+}
+Transport::Transport(unsigned bus, unsigned number, bool writable) {
+  LIBMTP_Init();
+  LIBMTP_raw_device_t *raw = nullptr;
+  int count = 0;
+  auto detected = LIBMTP_Detect_Raw_Devices(&raw, &count);
+  std::unique_ptr<LIBMTP_raw_device_t, decltype(&free)> devices(raw, free);
+  if (detected)
+    fail(ENODEV, "Detect MTP device");
+  uint16_t vendor = 0, product = 0;
+  for (int i = 0; i < count; ++i) {
+    if (raw[i].bus_location == bus && raw[i].devnum == number) {
+      vendor = raw[i].device_entry.vendor_id;
+      product = raw[i].device_entry.product_id;
+      device_ = LIBMTP_Open_Raw_Device_Uncached(&raw[i]);
+      break;
+    }
+  }
+  if (!device_)
+    fail(ENODEV, "Open MTP session; unlock the phone and enable file transfer");
+  try {
+    // Harmony devices can wait for the interrupt endpoint to be drained
+    // before completing a bulk reply. This bounded reader owns no catalogue
+    // state and is joined before libmtp frees the USB handle.
+    events_ = std::thread([this] {
+      while (!stop_events_) {
+        LIBMTP_event_t event;
+        uint32_t value;
+        if (LIBMTP_Read_Event_Timeout(device_, &event, &value, 500) < 0)
+          break;
+      }
+    });
+    LIBMTP_Clear_Errorstack(device_);
+    checked(LIBMTP_Get_Storage(device_, 0), "Query MTP storage");
+    for (auto s = device_->storage; s; s = s->next)
+      storages_.push_back(
+          {s->id, s->StorageDescription ? s->StorageDescription : "Storage",
+           s->MaxCapacity, s->FreeSpaceInBytes});
+    if (storages_.empty())
+      fail(ENODEV, "Phone returned no storage; allow data access on the phone");
+    if (!LIBMTP_Check_Capability(device_, LIBMTP_DEVICECAP_GetPartialObject))
+      fail(EOPNOTSUPP, "MTP device does not support bounded partial reads");
+    if (writable &&
+        (!LIBMTP_Check_Capability(device_,
+                                  LIBMTP_DEVICECAP_SendPartialObject) ||
+         !LIBMTP_Check_Capability(device_, LIBMTP_DEVICECAP_EditObjects)))
+      fail(EOPNOTSUPP, "Writable MTP requires partial writes and object "
+                       "editing; use a read-only mount");
+    can_move_ = LIBMTP_Check_Capability(device_, LIBMTP_DEVICECAP_MoveObject);
+    std::unique_ptr<char, decltype(&free)> serial(
+        LIBMTP_Get_Serialnumber(device_), free);
+    identity_ =
+        hash_text(std::to_string(vendor) + ":" + std::to_string(product) + ":" +
+                  (serial ? serial.get() : ""));
+    owner_ = std::thread([this] { run(); });
+  } catch (...) {
+    stop_events_ = true;
+    if (events_.joinable())
+      events_.join();
+    LIBMTP_Release_Device(device_);
+    device_ = nullptr;
+    throw;
+  }
+}
+Transport::~Transport() {
+  {
+    std::lock_guard lock(mutex_);
+    stopping_ = true;
+  }
+  ready_.notify_one();
+  if (owner_.joinable())
+    owner_.join();
+  stop_events_ = true;
+  if (events_.joinable())
+    events_.join();
+  if (device_)
+    LIBMTP_Release_Device(device_);
+}
+void Transport::run() {
+  unsigned foreground_count = 0;
+  for (;;) {
+    std::function<void()> task;
+    {
+      std::unique_lock lock(mutex_);
+      ready_.wait(lock, [this] {
+        return stopping_ || !foreground_.empty() || !background_.empty();
+      });
+      if (foreground_.empty() && background_.empty() && stopping_)
+        return;
+      bool use_foreground =
+          !foreground_.empty() && (background_.empty() || foreground_count < 8);
+      auto &queue = use_foreground ? foreground_ : background_;
+      task = std::move(queue.front());
+      queue.pop_front();
+      foreground_count = use_foreground ? foreground_count + 1 : 0;
+    }
+    task();
+  }
+}
+std::vector<RemoteEntry> Transport::list(uint32_t storage, uint32_t parent,
+                                         Priority priority) {
+  auto ids = call(priority, [=, this] {
+    uint32_t *values = nullptr;
+    int count = LIBMTP_Get_Children(
+        device_, storage, parent ? parent : LIBMTP_FILES_AND_FOLDERS_ROOT,
+        &values);
+    std::unique_ptr<uint32_t, decltype(&free)> owned(values, free);
+    if (count < 0)
+      checked(-1, ("List MTP directory " + std::to_string(storage) + "/" +
+                   std::to_string(parent))
+                      .c_str());
+    return count ? std::vector<uint32_t>(values, values + count)
+                 : std::vector<uint32_t>();
+  });
+  std::vector<RemoteEntry> result;
+  std::unordered_set<uint32_t> seen;
+  for (auto id : ids) {
+    // Observed on Samsung: GetObjectHandles can repeat the same handle after
+    // directory rename. Distinct handles with the same name remain a conflict.
+    if (!seen.insert(id).second)
+      continue;
+    try {
+      result.push_back(call(priority, [=, this] {
+        std::unique_ptr<LIBMTP_file_t, decltype(&LIBMTP_destroy_file_t)> entry(
+            LIBMTP_Get_Filemetadata(device_, id), LIBMTP_destroy_file_t);
+        if (!entry)
+          checked(-1, "Read MTP object metadata");
+        if (!entry->filename || !*entry->filename ||
+            std::strchr(entry->filename, '/'))
+          fail(EIO, "Phone returned an invalid filename");
+        return RemoteEntry{id,
+                           storage,
+                           parent,
+                           entry->filename,
+                           entry->filesize,
+                           entry->modificationdate,
+                           entry->filetype == LIBMTP_FILETYPE_FOLDER};
+      }));
+    } catch (const std::system_error &error) {
+      if (error.code().value() != ENOENT)
+        throw;
+      // A phone-side scan can remove an object after the handle list arrived.
+    }
+  }
+  return result;
+}
+std::vector<char> Transport::read(uint32_t object, uint64_t offset,
+                                  uint32_t size, Priority priority) {
+  std::vector<char> bytes;
+  while (bytes.size() < size) {
+    auto piece = call(priority, [=, this, done = bytes.size()] {
+      unsigned char *data = nullptr;
+      unsigned count = 0;
+      int result = LIBMTP_GetPartialObject(device_, object, offset + done,
+                                           size - done, &data, &count);
+      std::unique_ptr<unsigned char, decltype(&free)> owned(data, free);
+      checked(result, "Read MTP block");
+      if (count > size - done || (count && !data))
+        fail(EIO, "Invalid MTP block length");
+      return count ? std::vector<char>(data, data + count)
+                   : std::vector<char>();
+    });
+    if (piece.empty())
+      break;
+    bytes.insert(bytes.end(), piece.begin(), piece.end());
+  }
+  return bytes;
+}
+uint32_t Transport::create(uint32_t storage, uint32_t parent,
+                           const std::string &name, bool directory) {
+  return call(Priority::background, [=, this] {
+    auto root = parent ? parent : LIBMTP_FILES_AND_FOLDERS_ROOT;
+    if (directory) {
+      auto id = LIBMTP_Create_Folder(device_, const_cast<char *>(name.c_str()),
+                                     root, storage);
+      if (!id)
+        checked(-1, "Create MTP directory");
+      return id;
+    }
+    std::unique_ptr<LIBMTP_file_t, decltype(&LIBMTP_destroy_file_t)> entry(
+        LIBMTP_new_file_t(), LIBMTP_destroy_file_t);
+    if (!entry)
+      fail(ENOMEM, "Allocate MTP metadata");
+    entry->filename = strdup(name.c_str());
+    entry->parent_id = root;
+    entry->storage_id = storage;
+    entry->filesize = 0;
+    entry->filetype = LIBMTP_FILETYPE_UNKNOWN;
+    auto empty = open_file("/dev/null", O_RDONLY);
+    checked(LIBMTP_Send_File_From_File_Descriptor(
+                device_, empty.get(), entry.get(), nullptr, nullptr),
+            "Create empty MTP object");
+    return entry->item_id;
+  });
+}
+void Transport::begin(uint32_t object) {
+  call(Priority::background, [=, this] {
+    checked(LIBMTP_BeginEditObject(device_, object), "Begin MTP edit");
+  });
+}
+void Transport::write(uint32_t object, uint64_t offset,
+                      std::vector<char> bytes) {
+  call(Priority::background, [this, object, offset,
+                              bytes = std::move(bytes)]() mutable {
+    checked(LIBMTP_SendPartialObject(
+                device_, object, offset,
+                reinterpret_cast<unsigned char *>(bytes.data()), bytes.size()),
+            "Write MTP block");
+  });
+}
+void Transport::end(uint32_t object) {
+  call(Priority::background, [=, this] {
+    checked(LIBMTP_EndEditObject(device_, object), "Finish MTP edit");
+  });
+}
+void Transport::resize(uint32_t object, uint64_t size) {
+  call(Priority::background, [=, this] {
+    checked(LIBMTP_TruncateObject(device_, object, size), "Resize MTP object");
+  });
+}
+void Transport::rename(uint32_t object, const std::string &name) {
+  call(Priority::background, [=, this] {
+    checked(LIBMTP_Set_Object_Filename(device_, object,
+                                       const_cast<char *>(name.c_str())),
+            "Rename MTP object");
+  });
+}
+void Transport::move(uint32_t object, uint32_t storage, uint32_t parent) {
+  call(Priority::background, [=, this] {
+    checked(LIBMTP_Move_Object(device_, object, storage, parent),
+            "Move MTP object");
+  });
+}
+void Transport::remove(uint32_t object) {
+  call(Priority::background, [=, this] {
+    checked(LIBMTP_Delete_Object(device_, object), "Delete MTP object");
+  });
+}
+} // namespace mtpfs
diff --git a/mtpfs/src/transport.hpp b/mtpfs/src/transport.hpp
new file mode 100644
index 0000000..9600a99
--- /dev/null
+++ b/mtpfs/src/transport.hpp
@@ -0,0 +1,86 @@
+#pragma once
+#include "support.hpp"
+#include <atomic>
+#include <condition_variable>
+#include <deque>
+#include <functional>
+#include <future>
+#include <libmtp.h>
+#include <mutex>
+#include <thread>
+
+namespace mtpfs {
+struct RemoteEntry {
+  uint32_t id, storage, parent;
+  std::string name;
+  uint64_t size;
+  int64_t modified;
+  bool directory;
+};
+struct Storage {
+  uint32_t id;
+  std::string name;
+  uint64_t capacity, available;
+};
+enum class Priority { foreground, background };
+
+// One owner serializes bulk transactions. An upload submits one block at a
+// time, allowing foreground reads to run between blocks without sharing libmtp
+// state.
+class Transport {
+  LIBMTP_mtpdevice_t *device_ = nullptr;
+  std::mutex mutex_;
+  std::condition_variable ready_;
+  std::deque<std::function<void()>> foreground_, background_;
+  bool stopping_ = false;
+  std::thread owner_, events_;
+  std::atomic<bool> stop_events_{false};
+  std::exception_ptr failure_;
+  std::atomic<bool> failed_{false};
+  std::string identity_;
+  bool can_move_ = false;
+  std::vector<Storage> storages_;
+  void run();
+  void checked(int result, const char *operation);
+  template <class F>
+  auto call(Priority priority, F function) -> decltype(function()) {
+    using Result = decltype(function());
+    auto task = std::make_shared<std::packaged_task<Result()>>(
+        [this, function = std::move(function)]() mutable {
+          if (failure_)
+            std::rethrow_exception(failure_);
+          LIBMTP_Clear_Errorstack(device_);
+          return function();
+        });
+    auto result = task->get_future();
+    {
+      std::lock_guard lock(mutex_);
+      (priority == Priority::foreground ? foreground_ : background_)
+          .emplace_back([task] { (*task)(); });
+    }
+    ready_.notify_one();
+    return result.get();
+  }
+
+public:
+  Transport(unsigned bus, unsigned number, bool writable);
+  ~Transport();
+  Transport(const Transport &) = delete;
+  bool can_move() const { return can_move_; }
+  bool failed() const { return failed_; }
+  const std::string &identity() const { return identity_; }
+  const std::vector<Storage> &storages() const { return storages_; }
+  std::vector<RemoteEntry> list(uint32_t storage, uint32_t parent, Priority);
+  std::vector<char> read(uint32_t object, uint64_t offset, uint32_t size,
+                         Priority);
+  uint32_t create(uint32_t storage, uint32_t parent, const std::string &name,
+                  bool directory);
+  void begin(uint32_t object);
+  void write(uint32_t object, uint64_t offset, std::vector<char> bytes);
+  void resize(uint32_t object, uint64_t size);
+  void end(uint32_t object);
+  void rename(uint32_t object, const std::string &name);
+  void move(uint32_t object, uint32_t storage, uint32_t parent);
+  void remove(uint32_t object);
+};
+} // namespace mtpfs
