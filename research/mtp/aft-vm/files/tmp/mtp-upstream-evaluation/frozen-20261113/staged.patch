diff --git a/mtpfs/src/catalogue.cpp b/mtpfs/src/catalogue.cpp
new file mode 100644
index 0000000..86196d7
--- /dev/null
+++ b/mtpfs/src/catalogue.cpp
@@ -0,0 +1,611 @@
+#include "catalogue.hpp"
+#include <algorithm>
+#include <fcntl.h>
+#include <unistd.h>
+
+namespace mtpfs {
+namespace {
+bool private_name(const std::string &name) {
+  // Apple metadata is a mount-local sidecar. NFS silly-renames are real phone
+  // objects: treating .nfs names as sidecars would change an open file's
+  // backend.
+  return name.rfind("._", 0) == 0 || name == ".DS_Store";
+}
+void valid_name(const std::string &name) {
+  if (name.empty() || name == "." || name == ".." ||
+      name.find('/') != std::string::npos || name.size() > 255)
+    fail(EINVAL, "Invalid MTP filename");
+}
+} // namespace
+Catalogue::Catalogue(Transport &transport, std::filesystem::path root,
+                     bool writable)
+    : transport_(transport), root_(std::move(root)), writable_(writable) {
+  // A fresh session never opens an old writeback database or replays its work.
+  // The host allocates a new directory and preserves prior caches separately.
+  std::filesystem::create_directory(root_ / "read-cache");
+  auto root_entry = std::make_shared<Entry>();
+  root_entry->node.id = next_++;
+  root_entry->node.directory = root_entry->node.loaded = true;
+  root_entry->node.mode = 0755;
+  entries_.emplace(root_entry->node.id, root_entry);
+  for (auto &storage : transport.storages()) {
+    auto e = std::make_shared<Entry>();
+    e->node.id = next_++;
+    e->node.parent = 1;
+    e->node.name = storage.name + " (" + std::to_string(storage.id) + ")";
+    e->node.storage = storage.id;
+    e->node.directory = true;
+    e->node.mode = 0755;
+    e->node.accessed = e->node.modified = e->node.changed = now();
+    entries_.emplace(e->node.id, e);
+    names_.emplace(std::make_pair(1, e->node.name), e->node.id);
+  }
+  atomic_file(root_ / "session.pending", "direct MTP session\n");
+  status("mounted");
+}
+std::shared_ptr<Catalogue::Entry> Catalogue::entry(NodeId id) {
+  std::lock_guard lock(metadata_);
+  return entries_.at(id);
+}
+Node Catalogue::node(NodeId id) {
+  std::lock_guard lock(metadata_);
+  return entries_.at(id)->node;
+}
+void Catalogue::require_session() {
+  if (failed_ || transport_.failed())
+    fail(EIO, "MTP session failed; unmount before reconnecting");
+}
+void Catalogue::require_write() {
+  if (!writable_)
+    fail(EROFS, "Read-only MTP mount");
+  require_session();
+}
+void Catalogue::load_locked(NodeId id) {
+  auto e = entry(id);
+  auto n = node(id);
+  if (!n.directory)
+    fail(ENOTDIR, "Not an MTP directory");
+  if (n.deleted)
+    fail(ENOENT, "Removed MTP directory");
+  if (n.loaded)
+    return;
+  require_session();
+  auto listing =
+      n.local ? std::vector<RemoteEntry>()
+              : transport_.list(n.storage, e->object, Priority::foreground);
+  std::map<std::string, std::shared_ptr<Entry>> added;
+  for (auto &remote : listing) {
+    if (added.count(remote.name))
+      fail(EIO, "Phone returned duplicate directory names");
+    auto child = std::make_shared<Entry>();
+    child->node.id = next_++;
+    child->node.parent = id;
+    child->node.name = remote.name;
+    child->node.storage = n.storage;
+    child->node.directory = remote.directory;
+    child->node.mode = remote.directory ? 0755 : 0644;
+    child->node.size = remote.size;
+    child->node.accessed = child->node.modified = child->node.changed =
+        remote.modified;
+    child->object = remote.id;
+    added.emplace(remote.name, child);
+  }
+  std::lock_guard lock(metadata_);
+  for (auto &[name, child] : added) {
+    names_.emplace(std::make_pair(id, name), child->node.id);
+    entries_.emplace(child->node.id, child);
+  }
+  e->node.loaded = true;
+}
+void Catalogue::load(NodeId id) {
+  // Cached metadata must remain available while an unrelated upload waits.
+  if (node(id).loaded)
+    return;
+  std::lock_guard lock(namespace_);
+  load_locked(id);
+}
+std::vector<Node> Catalogue::children(NodeId id) {
+  load(id);
+  std::lock_guard lock(metadata_);
+  std::vector<Node> result;
+  for (auto &[key, child] : names_)
+    if (key.first == id)
+      result.push_back(entries_.at(child)->node);
+  return result;
+}
+NodeId Catalogue::lookup(const std::string &path) {
+  NodeId id = 1;
+  for (size_t start = 1; start < path.size();) {
+    auto end = path.find('/', start);
+    if (end == std::string::npos)
+      end = path.size();
+    load(id);
+    std::lock_guard lock(metadata_);
+    auto found = names_.find({id, path.substr(start, end - start)});
+    if (found == names_.end())
+      fail(ENOENT, "MTP path not found");
+    id = found->second;
+    start = end + 1;
+  }
+  return id;
+}
+std::string Catalogue::path_locked(NodeId id) {
+  // Caller owns namespace_; names cannot change during this walk.
+  std::string result;
+  for (; id > 1;) {
+    auto n = node(id);
+    result = "/" + n.name + result;
+    id = n.parent;
+  }
+  return result;
+}
+void Catalogue::status(const std::string &state, const std::string &error) {
+  std::lock_guard lock(status_);
+  atomic_file(root_ / "status.json", "{\"state\":" + json_quote(state) +
+                                         ",\"error\":" + json_quote(error) +
+                                         "}\n");
+}
+void Catalogue::namespace_failed(const std::exception &error) {
+  failed_ = true;
+  // Preserve the original I/O failure if writing its diagnostic also fails.
+  try {
+    status("failed", error.what());
+  } catch (const std::exception &e) {
+    fprintf(stderr, "mtpfs status: %s\n", e.what());
+  }
+}
+void Catalogue::data_failed(Entry &e) {
+  e.failure = std::current_exception();
+  try {
+    std::rethrow_exception(e.failure);
+  } catch (const std::exception &error) {
+    namespace_failed(error);
+  }
+}
+void Catalogue::clear_record(const std::filesystem::path &path) {
+  std::filesystem::remove(path);
+  sync_directory(root_);
+}
+void Catalogue::retain(Entry &e) {
+  auto n = node(e.node.id);
+  auto name = "ALFS-retained-" + unique_id();
+  std::string destination = path_locked(n.parent);
+  uint32_t parent = entry(n.parent)->object;
+  if (transport_.can_move()) {
+    auto found = retained_.find(n.storage);
+    if (found == retained_.end()) {
+      auto directory = "ALFS-open-" + unique_id();
+      atomic_file(root_ / ("retained-" + std::to_string(n.storage) + ".json"),
+                  "{\"storage\":" + std::to_string(n.storage) +
+                      ",\"directory\":" + json_quote(directory) + "}\n");
+      auto object = transport_.create(n.storage, 0, directory, true);
+      found = retained_.emplace(n.storage, RetainedDirectory{object, directory})
+                  .first;
+    }
+    parent = found->second.object;
+    destination = found->second.name;
+  }
+  atomic_file(root_ / ("orphan-" + std::to_string(n.id) + ".json"),
+              "{\"parent\":" + json_quote(path_locked(n.parent)) +
+                  ",\"original\":" + json_quote(n.name) +
+                  ",\"retained_parent\":" + json_quote(destination) +
+                  ",\"retained\":" + json_quote(name) + "}\n");
+  transport_.rename(e.object, name);
+  // Open-but-unlinked data must not keep its former user directory nonempty.
+  // Keep it in a session-owned storage-root directory when native moves exist.
+  if (transport_.can_move())
+    transport_.move(e.object, n.storage, parent);
+}
+void Catalogue::cache(Entry &e) {
+  if (e.cache.get() < 0)
+    e.cache = open_file(root_ / "read-cache" / std::to_string(e.node.id),
+                        O_CREAT | O_RDWR);
+}
+void Catalogue::begin(Entry &e) {
+  if (!e.node.local && !e.editing) {
+    transport_.begin(e.object);
+    e.editing = true;
+  }
+}
+void Catalogue::end(Entry &e) {
+  if (e.failure)
+    std::rethrow_exception(e.failure);
+  if (e.editing) {
+    transport_.end(e.object);
+    e.editing = false;
+  }
+}
+void Catalogue::discard(Entry &e) {
+  end(e);
+  if (!e.node.local && e.object) {
+    transport_.remove(e.object);
+    e.object = 0;
+  }
+  e.cache = Fd();
+  e.cached.clear();
+  std::filesystem::remove(root_ / "read-cache" / std::to_string(e.node.id));
+  clear_record(root_ / ("orphan-" + std::to_string(e.node.id) + ".json"));
+}
+NodeId Catalogue::create(NodeId parent, const std::string &name,
+                         bool directory) {
+  require_write();
+  valid_name(name);
+  std::lock_guard namespace_lock(namespace_);
+  require_write();
+  load_locked(parent);
+  auto p = entry(parent);
+  if (parent == 1)
+    fail(EPERM, "Cannot create a phone storage");
+  {
+    std::lock_guard lock(metadata_);
+    if (names_.count({parent, name}))
+      fail(EEXIST, "MTP name already exists");
+  }
+  auto e = std::make_shared<Entry>();
+  e->node.id = next_++;
+  e->node.parent = parent;
+  e->node.storage = p->node.storage;
+  e->node.name = name;
+  e->node.directory = directory;
+  e->node.mode = directory ? 0755 : 0644;
+  e->node.loaded = directory;
+  e->node.local = p->node.local || private_name(name);
+  if (!e->node.local)
+    e->object = transport_.create(e->node.storage, p->object, name, directory);
+  e->node.accessed = e->node.modified = e->node.changed = now();
+  std::lock_guard lock(metadata_);
+  names_.emplace(std::make_pair(parent, name), e->node.id);
+  entries_.emplace(e->node.id, e);
+  p->node.modified = p->node.changed = now();
+  return e->node.id;
+}
+void Catalogue::rename(NodeId id, NodeId parent, const std::string &name) {
+  require_write();
+  valid_name(name);
+  std::lock_guard namespace_lock(namespace_);
+  require_write();
+  load_locked(parent);
+  auto source = entry(id), destination = entry(parent);
+  auto n = node(id), p = node(parent);
+  if (n.deleted)
+    fail(ENOENT, "Removed MTP path");
+  if (n.parent == parent && n.name == name)
+    return;
+  if (n.parent == 1 || parent == 1)
+    fail(EPERM, "Cannot rename phone storage");
+  if (n.storage != p.storage)
+    fail(EXDEV, "Cross-storage rename");
+  if (n.local != (p.local || private_name(name)))
+    fail(EOPNOTSUPP, "Cannot move between phone objects and local sidecars");
+  if (!n.local && n.parent != parent && !transport_.can_move())
+    fail(EOPNOTSUPP, "Phone does not support native object moves");
+  for (auto ancestor = parent; ancestor > 1; ancestor = node(ancestor).parent)
+    if (ancestor == id)
+      fail(EINVAL, "Directory cycle");
+  std::shared_ptr<Entry> target;
+  {
+    std::lock_guard lock(metadata_);
+    auto found = names_.find({parent, name});
+    if (found != names_.end())
+      target = entries_.at(found->second);
+  }
+  if (target) {
+    auto t = node(target->node.id);
+    if (t.directory != n.directory)
+      fail(t.directory ? EISDIR : ENOTDIR, "Rename type mismatch");
+    if (t.directory) {
+      load_locked(t.id);
+      std::lock_guard lock(metadata_);
+      for (auto &[key, child] : names_)
+        if (key.first == t.id)
+          fail(ENOTEMPTY, "Rename target is not empty");
+    }
+  }
+  std::unique_lock source_lock(source->io);
+  std::unique_lock<std::mutex> target_lock;
+  if (target)
+    target_lock = std::unique_lock(target->io);
+  // MTP has no atomic replacement primitive. Preserve the destination object
+  // and its open handles, then publish the new namespace only after success.
+  // On an uncertain partial transaction, leave evidence and fail this session;
+  // never attempt an inverse operation over an already broken protocol stream.
+  auto transaction = root_ / "namespace.pending";
+  atomic_file(transaction, "{\"source\":" + json_quote(path_locked(id)) +
+                               ",\"destination\":" +
+                               json_quote(path_locked(parent) + "/" + name) +
+                               "}\n");
+  try {
+    end(*source);
+    if (target) {
+      end(*target);
+      if (!target->node.local) {
+        retain(*target);
+      }
+    }
+    if (!n.local) {
+      // For cross-directory moves use a unique temporary name so an unrelated
+      // same-named file in the destination is never replaced accidentally.
+      if (n.parent != parent) {
+        auto moving = "ALFS-moving-" + unique_id();
+        atomic_file(transaction,
+                    "{\"source\":" + json_quote(path_locked(id)) +
+                        ",\"destination\":" +
+                        json_quote(path_locked(parent) + "/" + name) +
+                        ",\"temporary\":" + json_quote(moving) + "}\n");
+        transport_.rename(source->object, moving);
+        transport_.move(source->object, n.storage, destination->object);
+      }
+      transport_.rename(source->object, name);
+    }
+    {
+      std::lock_guard lock(metadata_);
+      if (target) {
+        target->node.deleted = true;
+        target->node.changed = now();
+      }
+      names_.erase({n.parent, n.name});
+      names_[{parent, name}] = id;
+      source->node.parent = parent;
+      source->node.name = name;
+      source->node.changed = now();
+      entries_.at(n.parent)->node.modified =
+          entries_.at(n.parent)->node.changed = now();
+      destination->node.modified = destination->node.changed = now();
+    }
+    if (target && !target->handles)
+      discard(*target);
+    clear_record(transaction);
+  } catch (const std::exception &error) {
+    namespace_failed(error);
+    throw;
+  }
+}
+void Catalogue::remove(NodeId id, bool directory) {
+  require_write();
+  std::lock_guard namespace_lock(namespace_);
+  require_write();
+  auto e = entry(id);
+  auto n = node(id);
+  if (n.deleted)
+    fail(ENOENT, "Removed MTP path");
+  if (id == 1 || n.parent == 1)
+    fail(EPERM, "Cannot remove phone storage");
+  if (n.directory != directory)
+    fail(n.directory ? EISDIR : ENOTDIR, "Remove type mismatch");
+  if (directory) {
+    load_locked(id);
+    std::lock_guard lock(metadata_);
+    for (auto &[key, child] : names_)
+      if (key.first == id)
+        fail(ENOTEMPTY, "MTP directory is not empty");
+    if (!transport_.can_move())
+      for (auto &[child, value] : entries_)
+        if (value->node.parent == id && value->node.deleted && value->object)
+          fail(ENOTEMPTY,
+               "Phone cannot move open unlinked files out of this directory");
+  }
+  std::lock_guard io(e->io);
+  try {
+    end(*e);
+    if (e->handles) {
+      if (!n.local) {
+        retain(*e);
+      }
+    } else {
+      discard(*e);
+    }
+    std::lock_guard lock(metadata_);
+    names_.erase({n.parent, n.name});
+    e->node.deleted = true;
+    e->node.changed = now();
+    entries_.at(n.parent)->node.modified = entries_.at(n.parent)->node.changed =
+        now();
+  } catch (const std::exception &error) {
+    namespace_failed(error);
+    throw;
+  }
+}
+void Catalogue::open(NodeId id) {
+  require_session();
+  auto e = entry(id);
+  std::lock_guard io(e->io);
+  if (node(id).deleted)
+    fail(ENOENT, "Removed MTP file");
+  ++e->handles;
+}
+void Catalogue::close(NodeId id) {
+  auto e = entry(id);
+  std::lock_guard namespace_lock(namespace_);
+  std::lock_guard io(e->io);
+  --e->handles;
+  if (!e->handles && node(id).deleted) {
+    try {
+      require_session();
+      discard(*e);
+    } catch (const std::exception &error) {
+      namespace_failed(error);
+      throw;
+    }
+  } else if (!e->handles) {
+    // Page validity belongs to this session, not to an open descriptor. Keep
+    // the sparse cache reusable without retaining one fd for every visited
+    // file.
+    e->cache = Fd();
+  }
+}
+void Catalogue::invalidate(Entry &e, uint64_t offset, uint64_t size) {
+  if (!size)
+    return;
+  auto first = e.cached.lower_bound(offset / cache_block_size);
+  auto last = e.cached.upper_bound((offset + size - 1) / cache_block_size);
+  e.cached.erase(first, last);
+}
+std::vector<char> Catalogue::read(NodeId id, uint64_t offset, size_t size) {
+  require_session();
+  auto e = entry(id);
+  std::lock_guard io(e->io);
+  auto n = node(id);
+  if (offset >= n.size || !size)
+    return {};
+  size = std::min<uint64_t>(size, n.size - offset);
+  cache(*e);
+  if (n.local)
+    return read_at(e->cache.get(), size, offset);
+  for (auto pos = offset; pos < offset + size;) {
+    auto block = pos / cache_block_size;
+    if (e->cached.count(block)) {
+      pos = std::min<uint64_t>((block + 1) * cache_block_size, offset + size);
+      continue;
+    }
+    auto start = block * cache_block_size;
+    auto count = std::min<uint64_t>(transfer_block_size, n.size - start);
+    std::vector<char> bytes;
+    while (bytes.size() < count) {
+      auto part = transport_.read(e->object, start + bytes.size(),
+                                  count - bytes.size(), Priority::foreground);
+      if (part.empty())
+        fail(EIO, "Short MTP read before EOF");
+      bytes.insert(bytes.end(), part.begin(), part.end());
+    }
+    write_all(e->cache.get(), bytes.data(), bytes.size(), start);
+    for (auto b = block; b * cache_block_size < start + count; ++b)
+      e->cached.insert(b);
+    pos = std::min<uint64_t>(start + count, offset + size);
+  }
+  auto bytes = read_at(e->cache.get(), size, offset);
+  if (bytes.size() != size)
+    fail(EIO, "Incomplete MTP read cache");
+  return bytes;
+}
+void Catalogue::write(NodeId id, uint64_t offset, const char *bytes,
+                      size_t size) {
+  require_write();
+  auto e = entry(id);
+  std::lock_guard io(e->io);
+  require_write();
+  if (e->failure)
+    std::rethrow_exception(e->failure);
+  if (!size)
+    return;
+  auto n = node(id);
+  try {
+    begin(*e);
+    // NFS can submit later ranges first. Android partial-write rejects a gap;
+    // extend the remote object before sending bytes beyond its current EOF.
+    if (!n.local && offset > n.size)
+      transport_.resize(e->object, offset);
+    if (!n.local)
+      for (size_t done = 0; done < size;) {
+        auto count = std::min<uint64_t>(transfer_block_size, size - done);
+        transport_.write(e->object, offset + done,
+                         std::vector<char>(bytes + done, bytes + done + count));
+        done += count;
+      }
+    cache(*e);
+    invalidate(*e, offset, size);
+    if (offset + size > n.size && n.size % cache_block_size)
+      e->cached.erase(n.size / cache_block_size);
+    write_all(e->cache.get(), bytes, size, offset);
+    // Only complete pages can replace a cached remote read without fetching
+    // untouched bytes. This is a read cache, never an upload queue.
+    for (auto b = (offset + cache_block_size - 1) / cache_block_size;
+         (b + 1) * cache_block_size <= offset + size; ++b)
+      e->cached.insert(b);
+    std::lock_guard lock(metadata_);
+    e->node.size = std::max<uint64_t>(n.size, offset + size);
+    e->node.modified = e->node.changed = now();
+  } catch (...) {
+    data_failed(*e);
+    throw;
+  }
+}
+void Catalogue::truncate(NodeId id, uint64_t size) {
+  require_write();
+  auto e = entry(id);
+  std::lock_guard io(e->io);
+  require_write();
+  auto n = node(id);
+  try {
+    begin(*e);
+    if (!n.local)
+      transport_.resize(e->object, size);
+    cache(*e);
+    check(ftruncate(e->cache.get(), size) == 0, "Resize MTP read cache");
+    auto changed = std::min(n.size, size);
+    e->cached.erase(e->cached.lower_bound(changed / cache_block_size),
+                    e->cached.end());
+    std::lock_guard lock(metadata_);
+    e->node.size = size;
+    e->node.modified = e->node.changed = now();
+  } catch (...) {
+    data_failed(*e);
+    throw;
+  }
+}
+void Catalogue::sync(NodeId id) {
+  require_session();
+  auto e = entry(id);
+  std::lock_guard io(e->io);
+  try {
+    require_session();
+    end(*e);
+    if (e->node.local && e->cache.get() >= 0)
+      sync_file(e->cache.get());
+  } catch (...) {
+    data_failed(*e);
+    throw;
+  }
+}
+void Catalogue::touch(NodeId id, const timespec times[2]) {
+  require_write();
+  auto e = entry(id);
+  std::lock_guard io(e->io);
+  if (times[1].tv_nsec != UTIME_OMIT) {
+    auto modified = times[1].tv_nsec == UTIME_NOW
+                        ? now()
+                        : times[1].tv_sec + times[1].tv_nsec / 1e9;
+    // Android may reject DateModified (observed response A80A). Like Unix
+    // modes and access times, timestamps describe this mounted view; remount
+    // reloads the phone's metadata. No unsupported property command is sent.
+    std::lock_guard lock(metadata_);
+    e->node.modified = modified;
+    e->node.changed = now();
+  }
+  // MTP has no access-time property; expose it for the lifetime of this mount.
+  if (times[0].tv_nsec != UTIME_OMIT) {
+    std::lock_guard lock(metadata_);
+    e->node.accessed = times[0].tv_nsec == UTIME_NOW
+                           ? now()
+                           : times[0].tv_sec + times[0].tv_nsec / 1e9;
+  }
+}
+void Catalogue::chmod(NodeId id, mode_t mode) {
+  require_write();
+  std::lock_guard lock(metadata_);
+  // Unix permissions are a mount-local view; MTP does not provide Unix modes.
+  entries_.at(id)->node.mode = mode & 0777;
+  entries_.at(id)->node.changed = now();
+}
+void Catalogue::finish() {
+  require_session();
+  std::lock_guard namespace_lock(namespace_);
+  for (auto &[id, e] : entries_) {
+    std::lock_guard io(e->io);
+    try {
+      if (e->node.deleted)
+        discard(*e);
+      else
+        end(*e);
+    } catch (const std::exception &error) {
+      namespace_failed(error);
+      throw;
+    }
+  }
+  for (auto &[storage, directory] : retained_) {
+    transport_.remove(directory.object);
+    clear_record(root_ / ("retained-" + std::to_string(storage) + ".json"));
+  }
+  status("complete");
+  clear_record(root_ / "session.pending");
+}
+} // namespace mtpfs
