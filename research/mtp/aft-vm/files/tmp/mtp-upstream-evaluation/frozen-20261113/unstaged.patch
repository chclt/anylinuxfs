+pub(crate) fn force_unmount(path: &Path) -> anyhow::Result<()> {
+    #[cfg(target_os = "macos")]
+    let mut command = {
+        let mut c = std::process::Command::new("/usr/sbin/diskutil");
+        c.args(["unmount", "force"]);
+        c
+    };
+    #[cfg(target_os = "linux")]
+    let mut command = {
+        let mut c = std::process::Command::new("umount");
+        c.arg("-f");
+        c
+    };
+    let status = command
+        .arg(path)
+        .status()
+        .context("Unmount failed MTP NFS volume")?;
+    anyhow::ensure!(
+        status.success(),
+        "Could not unmount failed MTP volume {}: {status}",
+        path.display()
+    );
