+		void DirectoryChanged(FuseId inode)
+		{
+			auto &stamp = _directoryChanged[inode];
+			timespec now;
+			clock_gettime(CLOCK_REALTIME, &now);
+			if (now.tv_sec < stamp.tv_sec || (now.tv_sec == stamp.tv_sec && now.tv_nsec <= stamp.tv_nsec))
+			{
+				now = stamp;
+				if (++now.tv_nsec == 1000000000) { ++now.tv_sec; now.tv_nsec = 0; }
+			}
+			stamp = now;
+		}
