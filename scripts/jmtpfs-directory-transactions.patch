+#include "MtpDirectoryTransactions.h"
+#include "MtpRecovery.h"
+#include "mtpFilesystemErrors.h"
+#include <sstream>
+
+void MtpDirectoryTransactions::requireMutable(uint32_t id) const
+{
+	auto item = m_pending.find(id);
+	if (item != m_pending.end())
+		throw MtpFilesystemErrorWithErrorCode(EIO, "MTP directory requires recovery: " + item->second);
+}
+
+void MtpDirectoryTransactions::Rename(MtpDevice& device, const MtpFileInfo& source,
+	uint32_t parentId, const std::string& name, uint32_t targetId)
+{
+	requireMutable(source.id);
+	requireMutable(parentId ? parentId : source.storageId);
+	if (targetId)
+		requireMutable(targetId);
+	bool moving = parentId != source.parentId;
+	bool renaming = name != source.name;
+	if (moving)
+		device.RequireObjectMove();
+	if (renaming || targetId)
+		device.RequireFileRename(LIBMTP_FILETYPE_FOLDER);
+	if (!targetId && !(moving && renaming))
+	{
+		if (moving)
+			device.MoveObject(source.id, source.storageId, parentId);
+		else if (renaming)
+			device.RenameFile(source.id, name);
+		return;
+	}
+
+	std::string path = MtpRecovery::newDirectoryRecord();
+	std::string suffix = path.substr(path.find_last_of('/') + 1);
+	suffix.resize(suffix.size() - 7); // .record
+	std::string stagingName = ".alfs-move-" + suffix;
+	std::string backupName = ".alfs-backup-" + suffix;
+	m_pending[source.id] = path;
+	if (targetId)
+		m_pending[targetId] = path;
+	auto record = [&](const char* stage)
+	{
+		std::ostringstream text;
+		text << "version=1\noperation=directory-rename\nstage=" << stage << "\n"
+			<< "source_id=" << source.id << "\n"
+			<< "source_parent_id=" << source.parentId << "\n"
+			<< "storage_id=" << source.storageId << "\n"
+			<< "source_name_hex=" << MtpRecovery::hexName(source.name) << "\n"
+			<< "target_id=" << targetId << "\n"
+			<< "parent_id=" << parentId << "\n"
+			<< "target_name_hex=" << MtpRecovery::hexName(name) << "\n"
+			<< "staging_name_hex=" << MtpRecovery::hexName(stagingName) << "\n"
+			<< "backup_name_hex=" << MtpRecovery::hexName(backupName) << "\n";
+		MtpRecovery::write(path, text.str());
+	};
+	if (targetId)
+	{
+		record("backing-up");
+		device.RenameFile(targetId, backupName);
+	}
+	if (moving && renaming)
+	{
+		// Move under a unique name; the old name may exist in the new parent.
+		record("staging");
+		device.RenameFile(source.id, stagingName);
+	}
+	if (moving)
+	{
+		record("moving");
+		device.MoveObject(source.id, source.storageId, parentId);
+	}
+	if (renaming)
+	{
+		record("publishing");
+		device.RenameFile(source.id, name);
+	}
+	if (targetId)
+	{
+		record("cleaning-up");
+		device.DeleteObject(targetId);
+	}
+	record("complete");
+	MtpRecovery::remove(path);
+	m_pending.erase(source.id);
+	if (targetId)
+		m_pending.erase(targetId);
+}
