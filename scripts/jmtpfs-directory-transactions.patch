+
+#include "MtpRecovery.h"
+#include "mtpFilesystemErrors.h"
+#include <sys/stat.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <cstdlib>
+#include <memory>
+#include <vector>
+
+std::string MtpRecovery::directory()
+{
+	const char* value = getenv("JMTPFS_WRITEBACK_DIR");
+	std::string path = value ? value : "/tmp/mtp-writeback";
+	if (mkdir(path.c_str(), 0700) && errno != EEXIST)
+		throw CantCreateTempFile(errno);
+	return path;
+}
+
+std::string MtpRecovery::hexName(const std::string& name)
+{
+	const char* digits = "0123456789abcdef";
+	std::string result;
+	for (unsigned char byte : name)
+	{
+		result += digits[byte >> 4];
+		result += digits[byte & 15];
+	}
+	return result;
+}
+
+std::string MtpRecovery::newDirectoryRecord()
+{
+	std::string pattern = directory() + "/directory-XXXXXX.record";
+	std::vector<char> name(pattern.begin(), pattern.end());
+	name.push_back(0);
+	int fd = mkstemps(name.data(), 7);
+	if (fd < 0)
+		throw CantCreateTempFile(errno);
+	close(fd);
+	return name.data();
+}
+
+static void syncDirectory(const std::string& path)
+{
+	std::string directory = path.substr(0, path.find_last_of('/'));
+	int fd = open(directory.c_str(), O_RDONLY | O_DIRECTORY);
+	if (fd < 0)
+		throw WriteError(errno);
+	int result = fsync(fd);
+	int error = errno;
+	close(fd);
+	if (result)
+		throw WriteError(error);
+}
+
+void MtpRecovery::write(const std::string& path, const std::string& content)
+{
+	std::string next = path + ".next";
+	std::unique_ptr<FILE, int (*)(FILE*)> output(fopen(next.c_str(), "w"), fclose);
+	if (!output)
+		throw WriteError(errno);
+	if (fwrite(content.data(), 1, content.size(), output.get()) != content.size()
+		|| fflush(output.get()) || fsync(fileno(output.get())))
+		throw WriteError(errno);
+	if (rename(next.c_str(), path.c_str()))
+		throw WriteError(errno);
+	syncDirectory(path);
+}
+
+void MtpRecovery::remove(const std::string& path)
+{
+	for (const std::string& entry : { path, path + ".next" })
+		if (unlink(entry.c_str()) && errno != ENOENT)
+			throw WriteError(errno);
+	syncDirectory(path);
+}
