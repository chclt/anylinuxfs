+
+void MtpDevice::ReadEvents()
+{
+	// Some phones wait for event delivery before replying to a rename. This
+	// must run independently of MtpLibLock and never modify the metadata cache.
+	while (!m_stopEvents.load())
+	{
+		LIBMTP_event_t event;
+		uint32_t parameter = 0;
+		if (LIBMTP_Read_Event_Timeout(m_mtpdevice, &event, &parameter, 500) < 0)
+		{
+			std::fprintf(stderr, "MTP event reader stopped: USB read failed\n");
+			break;
+		}
+	}
