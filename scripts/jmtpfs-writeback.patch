+
+void MtpLocalFileCopy::syncDirectory()
+{
+	int fd = open(m_directory.c_str(), O_RDONLY | O_DIRECTORY);
+	if (fd < 0)
+		throw WriteError(errno);
+	int result = fsync(fd);
+	int error = errno;
+	close(fd);
+	if (result)
+		throw WriteError(error);
+}
+
+void MtpLocalFileCopy::record(Stage stage)
+{
+	m_stage = stage;
+	static const char* stages[] = { "clean", "dirty", "uploading", "backing-up",
+		"publishing", "cleaning-up", "complete" };
+	std::ostringstream text;
+	text << "version=1\n" << "stage=" << stages[stage] << "\n"
+		<< "original_id=" << m_remoteId << "\n"
+		<< "replacement_id=" << m_replacementId << "\n"
+		<< "parent_id=" << m_target.parentId << "\n"
+		<< "storage_id=" << m_target.storageId << "\n"
+		<< "target_name_hex=" << hexName(m_target.name) << "\n"
+		<< "upload_name_hex=" << hexName(m_uploadName) << "\n"
+		<< "backup_name_hex=" << hexName(m_backupName) << "\n";
+	std::string next = m_recordPath + ".next";
+	std::unique_ptr<FILE, int (*)(FILE*)> output(fopen(next.c_str(), "w"), fclose);
+	if (!output)
+		throw WriteError(errno);
+	std::string content = text.str();
+	if (fwrite(content.data(), 1, content.size(), output.get()) != content.size()
+		|| fflush(output.get()) || fsync(fileno(output.get())))
+		throw WriteError(errno);
+	if (rename(next.c_str(), m_recordPath.c_str()))
+		throw WriteError(errno);
+	syncDirectory();
+}
+
+void MtpLocalFileCopy::syncData()
+{
+	if (fflush(m_localFile) || fsync(fileno(m_localFile)))
+		throw WriteError(errno);
+}
+
+void MtpLocalFileCopy::beginWrite()
+{
+	if (m_stage == Clean)
+	{
+		m_target = m_device.GetFileInfo(m_remoteId);
+		m_replacementId = 0;
+		syncData();
+		record(Dirty);
+	}
+	else if (m_stage != Dirty)
+		throw MtpFilesystemErrorWithErrorCode(EIO, "MTP writeback requires recovery: " + m_recordPath);
 }
 
