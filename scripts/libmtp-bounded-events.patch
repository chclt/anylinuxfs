+/* A bounded interrupt read lets the owner join its event thread before freeing
+ * params or the USB handle. It does not alter the bulk timeout or error stack. */
+int ptp_usb_event_wait_timeout(PTPParams *params, PTPContainer *event,
+                               unsigned int timeout_ms) {
+  PTP_USB *usb = params->data;
+  PTPUSBEventContainer packet = {0};
+  int length = 0;
+  int result = libusb_interrupt_transfer(usb->handle, usb->intep,
+      (unsigned char *)&packet, sizeof(packet), &length, timeout_ms);
+  if (result == LIBUSB_ERROR_TIMEOUT) return 1;
+  if (result != 0 || length < 12) return -1;
+  event->Code = dtoh16(packet.code);
+  event->SessionID = params->session_id;
+  event->Transaction_ID = dtoh32(packet.trans_id);
+  event->Param1 = dtoh32(packet.param1);
+  event->Param2 = dtoh32(packet.param2);
+  event->Param3 = dtoh32(packet.param3);
+  return 0;
+}
