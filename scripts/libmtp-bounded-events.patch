+/**
+ * Read one event with a finite, nonzero timeout in milliseconds (libusb-1.0).
+ * Returns 0 for an event, 1 for timeout, -1 for a transport error.
+ * The device owner must stop and join the reader before Release_Device.
+ */
+int LIBMTP_Read_Event_Timeout(LIBMTP_mtpdevice_t *device, LIBMTP_event_t *event,
+                             uint32_t *out1, unsigned int timeout_ms)
+{
+#ifdef HAVE_LIBUSB1
+  PTPContainer packet = {0};
+  int result = ptp_usb_event_wait_timeout(device->params, &packet, timeout_ms);
+  if (result != 0) return result;
+  LIBMTP_Handle_Event(&packet, event, out1);
+  return 0;
+#else
+  return -1;
+#endif
+}
